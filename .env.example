# --- CognoDB / Neo4j Connection ---
COGNODB_URI=bolt+s://your-instance.cognodb.example.com:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=replace-me
GRAPH_BACKEND=auto
PORT=8000

# --- Ingestion & Resource Limits ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
MAX_REPO_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_INDIVIDUAL_FILE_MB=5
INGESTION_TIMEOUT_SECONDS=120

# --- Security & Audit Collectors ---
OSV_API_URL=https://api.osv.dev/v1/query
DETECT_SECRETS_CONFIG=./config/secrets-baseline.json

# --- LLM Roadmap Synthesis ---
ANTHROPIC_API_KEY=
ROADMAP_MODEL=claude-sonnet-5

# --- Worker Sandbox Configuration ---
SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_WALLTIME_SECONDS=180

# --- Data Retention ---
REPORT_RETENTION_HOURS=24
