# --- Runtime Environment & Database ---
ENV=development
DATABASE_URL=sqlite:///.data/codit.db
JOB_WORKERS=2
PORT=8000

# --- Security & Test Keys (for test suites only) ---
STRIPE_API_KEY=your_stripe_test_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
COOKIE_SECRET=

# --- CognoDB / Neo4j Connection (optional external graph store) ---
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
GRAPH_BACKEND=demo

# --- Ingestion & Resource Limits ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_TOKEN=
MAX_REPO_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_INDIVIDUAL_FILE_MB=5
INGESTION_TIMEOUT_SECONDS=120

# --- History Ingestion Limits ---
HISTORY_MAX_COMMITS=500
HISTORY_MAX_DAYS=365
HISTORY_MAX_FILES_PER_COMMIT=200
HISTORY_MAX_BLOB_KB=1024
HISTORY_TRANSFER_MAX_MB=200
HISTORY_WALLTIME_SECONDS=120
HISTORY_MEM_MB=1024

# --- License Lookup Controls ---
DEPSDEV_BASE_URL=https://api.deps.dev
LICENSE_LOOKUP_CONCURRENCY=8
LICENSE_LOOKUP_BUDGET_SECONDS=25

# --- Security & Executive Narrative ---
OSV_API_URL=https://api.osv.dev/v1/query
ANTHROPIC_API_KEY=
ROADMAP_MODEL=claude-sonnet-5
EXEC_LLM_ENABLED=true

# --- Worker Resource Bounds ---
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_WALLTIME_SECONDS=180

# --- Data Retention, Staging & Cleanup ---
AUDIT_RETENTION_HOURS=24
STAGING_DIR=.data/staging
STAGING_TTL_MINUTES=15

# --- Attestations & Admin ---
ATTESTATION_RETENTION_DAYS=30
ATTEST_TTL_DAYS=90
ATTEST_SIGNING_KEY=
ATTEST_KEY_ID=
ADMIN_TOKEN=
PUBLIC_BASE_URL=https://coditt.xyz

# --- CORS, Rate Limits & Request Guards ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_RPM=120
RATE_LIMIT_INGEST_RPM=10
RATE_LIMIT_ANALYZE_RPM=4
RATE_LIMIT_REPORT_RPM=20
RATE_LIMIT_AUDITS_RPM=4
RATE_LIMIT_ATTEST_RPM=6
RATE_LIMIT_PUBLIC_RPM=120
RATE_LIMIT_ADMIN_RPM=10
MAX_REQUEST_BODY_MB=50
REQUEST_TIMEOUT_SECONDS=300
ALLOWED_HOSTS=*
