# --- Security & Test Keys ---
# Used for testing secret detection rules in local environments
STRIPE_API_KEY=your_stripe_test_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here

# --- CognoDB / Neo4j Connection ---
COGNODB_URI=bolt+s://your-instance.cognodb.example.com:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_password_here
GRAPH_BACKEND=auto
PORT=8000

# --- Ingestion & Resource Limits ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
MAX_REPO_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_INDIVIDUAL_FILE_MB=5
INGESTION_TIMEOUT_SECONDS=120

# --- Security & Audit Collectors ---
OSV_API_URL=https://api.osv.dev/v1/query
DETECT_SECRETS_CONFIG=./config/secrets-baseline.json

# --- LLM Roadmap Synthesis ---
ANTHROPIC_API_KEY=
ROADMAP_MODEL=claude-sonnet-5

# --- Worker Sandbox Configuration ---
SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_WALLTIME_SECONDS=180

# --- Data Retention ---
REPORT_RETENTION_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins. Set to your actual frontend URL in production.
# Example: CORS_ORIGINS=https://codit.yourcompany.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate Limiting ---
# Set RATE_LIMIT_ENABLED=false to disable during testing
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_RPM=120    # requests per 60 seconds — all endpoints not listed below
RATE_LIMIT_INGEST_RPM=10      # /api/ingest/* (expensive: clones, ZIP extraction)
RATE_LIMIT_ANALYZE_RPM=4      # /api/analyze/run (heavy CPU/mem pipeline)
RATE_LIMIT_REPORT_RPM=20      # /api/report/markdown, /api/report/html

# --- Request Guards ---
MAX_REQUEST_BODY_MB=50         # Hard ceiling on incoming request body size
REQUEST_TIMEOUT_SECONDS=300    # Cancel requests that take longer than this
# Comma-separated list of allowed Host header values.
# Set to "*" (default) to disable host checking in development.
# Example: ALLOWED_HOSTS=codit.yourcompany.com,api.yourcompany.com
ALLOWED_HOSTS=*

